  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Theme Toggle
      const themeToggleBtn = document.getElementById('themeToggleBtn');
      const lightIcon = document.getElementById('themeIconLight');
      const darkIcon = document.getElementById('themeIconDark');
      const rootHtml = document.documentElement;

      function syncTheme(isDark) {
        rootHtml.classList.toggle('dark', isDark);
        lightIcon?.classList.toggle('hidden', !isDark);
        darkIcon?.classList.toggle('hidden', isDark);
      }

      const savedTheme = localStorage.getItem('devcraft_theme') === 'dark';
      syncTheme(savedTheme);

      themeToggleBtn?.addEventListener('click', () => {
        const nextDark = !rootHtml.classList.contains('dark');
        syncTheme(nextDark);
        localStorage.setItem('devcraft_theme', nextDark ? 'dark' : 'light');
      });

      // Saved Modal Sync
      const STORAGE_KEY = 'divcraft_saved_tools_v1';
      const savedCounter = document.getElementById('savedCounter');
      const savedModal = document.getElementById('savedModal');
      const savedToolsList = document.getElementById('savedToolsList');
      const headerSavedBtn = document.getElementById('headerSavedBtn');
      const closeSavedModal = document.getElementById('closeSavedModal');
      const doneSavedModal = document.getElementById('doneSavedModal');
      const clearSavedBtn = document.getElementById('clearSavedBtn');

      function getSaved() {
        try {
          const data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          return Array.isArray(data) ? data : [];
        } catch {
          return [];
        }
      }

      function setSaved(items) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        if (savedCounter) {
          savedCounter.textContent = String(items.length);
          savedCounter.classList.toggle('hidden', items.length === 0);
        }
      }

      function renderSaved() {
        const items = getSaved();
        if (!savedToolsList) return;
        if (items.length === 0) {
          savedToolsList.innerHTML = `<p class="text-on-surface-variant py-4 text-center">No saved tools yet. Bookmark any tool from the hub to keep it here.</p>`;
          return;
        }
        savedToolsList.innerHTML = items.map(item => `
          <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-surface-container border border-outline/10">
            <span class="font-semibold text-on-surface truncate">${item.title}</span>
            <button type="button" data-remove-id="${item.id}" class="remove-saved-btn text-[11px] font-mono text-primary hover:underline shrink-0">Remove</button>
          </div>
        `).join('');

        savedToolsList.querySelectorAll('.remove-saved-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-remove-id');
            const next = getSaved().filter(x => x.id !== id);
            setSaved(next);
            renderSaved();
          });
        });
      }

      setSaved(getSaved());

      headerSavedBtn?.addEventListener('click', () => {
        renderSaved();
        savedModal?.classList.remove('hidden');
        savedModal?.classList.add('flex');
      });

      function hideSavedModal() {
        savedModal?.classList.add('hidden');
        savedModal?.classList.remove('flex');
      }

      closeSavedModal?.addEventListener('click', hideSavedModal);
      doneSavedModal?.addEventListener('click', hideSavedModal);
      savedModal?.addEventListener('click', (e) => {
        if (e.target === savedModal) hideSavedModal();
      });
      clearSavedBtn?.addEventListener('click', () => {
        setSaved([]);
        renderSaved();
      });

      // FAQ Accordion
      document.querySelectorAll('.faq-item').forEach(item => {
        const toggle = item.querySelector('.faq-toggle');
        const content = item.querySelector('.faq-content');
        const arrow = item.querySelector('.faq-arrow');
        toggle?.addEventListener('click', () => {
          if (!content) return;
          const willOpen = content.classList.contains('hidden');
          content.classList.toggle('hidden', !willOpen);
          if (arrow) arrow.style.transform = willOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        });
      });
    });
  </script>

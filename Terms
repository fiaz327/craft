  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const themeToggleBtn = document.getElementById('themeToggleBtn'), lightIcon = document.getElementById('themeIconLight'), darkIcon = document.getElementById('themeIconDark'), rootHtml = document.documentElement;
      function syncTheme(d){ rootHtml.classList.toggle('dark', d); lightIcon?.classList.toggle('hidden', !d); darkIcon?.classList.toggle('hidden', d); }
      syncTheme(localStorage.getItem('devcraft_theme') === 'dark');
      themeToggleBtn?.addEventListener('click', () => { const n = !rootHtml.classList.contains('dark'); syncTheme(n); localStorage.setItem('devcraft_theme', n ? 'dark' : 'light'); });

      const KEY = 'divcraft_saved_tools_v1', savedCounter = document.getElementById('savedCounter'), savedModal = document.getElementById('savedModal'), savedToolsList = document.getElementById('savedToolsList');
      function getSaved(){ try{ const x = JSON.parse(localStorage.getItem(KEY)||'[]'); return Array.isArray(x)?x:[]; }catch{ return []; } }
      function setSaved(items){ localStorage.setItem(KEY, JSON.stringify(items)); if(savedCounter){ savedCounter.textContent = String(items.length); savedCounter.classList.toggle('hidden', items.length===0); } }
      function renderSaved(){ const items = getSaved(); if(!savedToolsList)return; savedToolsList.innerHTML = items.length ? items.map(i=>`<div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-surface-container"><span class="font-semibold text-on-surface truncate">${i.title}</span><button type="button" data-remove-id="${i.id}" class="remove-saved-btn text-[11px] font-mono text-primary hover:underline">Remove</button></div>`).join('') : `<p class="text-on-surface-variant py-4 text-center">No saved tools yet.</p>`; savedToolsList.querySelectorAll('.remove-saved-btn').forEach(b=>b.addEventListener('click',()=>{ setSaved(getSaved().filter(x=>x.id!==b.getAttribute('data-remove-id'))); renderSaved(); })); }
      setSaved(getSaved());
      document.getElementById('headerSavedBtn')?.addEventListener('click', ()=>{ renderSaved(); savedModal?.classList.remove('hidden'); savedModal?.classList.add('flex'); });
      const closeM = ()=>{ savedModal?.classList.add('hidden'); savedModal?.classList.remove('flex'); };
      document.getElementById('closeSavedModal')?.addEventListener('click', closeM);
      document.getElementById('doneSavedModal')?.addEventListener('click', closeM);
      document.getElementById('clearSavedBtn')?.addEventListener('click', ()=>{ setSaved([]); renderSaved(); });
    });
  </script>
